{
	"name": "@xsynaptic/plazmoid-wavedata",
	"version": "0.1.1",
	"description": "The waveform format used by the Plazmoid audio player",
	"homepage": "https://github.com/xsynaptic/plazmoid#readme",
	"bugs": {
		"url": "https://github.com/xsynaptic/plazmoid/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/plazmoid.git",
		"directory": "packages/plazmoid-wavedata"
	},
	"license": "MIT",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./fixtures/*": "./fixtures/*"
	},
	"imports": {
		"#*": "./src/*"
	},
	"files": [
		"dist",
		"fixtures",
		"FORMAT.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"imports": {}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.shipped.json"
	},
	"devDependencies": {
		"publint": "^0.3.25",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3"
	}
}
