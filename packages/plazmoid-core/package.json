{
	"name": "@xsynaptic/plazmoid-core",
	"version": "0.3.1",
	"description": "The playback engine behind the Plazmoid audio player",
	"keywords": [
		"audio-player",
		"playback",
		"queue",
		"media-session",
		"headless"
	],
	"homepage": "https://github.com/xsynaptic/plazmoid#readme",
	"bugs": {
		"url": "https://github.com/xsynaptic/plazmoid/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/plazmoid.git",
		"directory": "packages/plazmoid-core"
	},
	"license": "MIT",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./boot": {
			"types": "./dist/boot.d.ts",
			"import": "./dist/boot.js"
		},
		"./constants": {
			"types": "./dist/constants.d.ts",
			"import": "./dist/constants.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js"
		}
	},
	"imports": {
		"#*": "./src/*"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"imports": {}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.shipped.json"
	},
	"dependencies": {
		"@xsynaptic/plazmoid-wavedata": "workspace:^",
		"zustand": "^5.1.0"
	},
	"peerDependencies": {
		"vitest": "^5.1.1"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@fast-check/vitest": "^0.5.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"vitest": "^5.1.1"
	}
}
